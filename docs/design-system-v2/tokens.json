{
  "$comment": "RMinte 设计令牌 v2。状态：方向已确认（D1–D7），色阶、动效、字阶与支持页主题已在 website/assets/styles.css 采用。生产规范仍以根目录 DESIGN.md 为准。",
  "color": {
    "neutral": {
      "n-0": "#000000", "n-1": "#07080A", "n-2": "#0D0F12", "n-3": "#14171B", "n-4": "#1C2026",
      "n-5": "#2A3037", "n-6": "#585F69", "n-7": "#858C95", "n-8": "#B6BCC4", "n-9": "#F2F4F6"
    },
    "surface": {
      "product-page": "#000000",
      "support-page": "#0D0F12",
      "support-panel": "#14171B",
      "hover": "#1C2026"
    },
    "text": {
      "text-1": "#F2F4F6",
      "text-2": "#B6BCC4",
      "text-3": "#858C95",
      "text-4": "#585F69"
    },
    "text-contrast-on-black": { "text-1": 19.0, "text-2": 11.0, "text-3": 6.2, "text-4": 3.3, "note": "text-4 仅装饰或禁用，不得承载信息" },
    "text-contrast-on-n-2": { "text-2": 10.0 },
    "line": {
      "line-1": "rgba(255,255,255,.08)",
      "line-2": "rgba(255,255,255,.14)",
      "line-3": "rgba(255,255,255,.24)"
    },
    "signal": {
      "sapphire-300": "#A8B8F0",
      "sapphire-500": "#6E86E0",
      "sapphire-wash": "12% 填充",
      "thermal-warm": "#E58B5A",
      "status-amber": "#E5B15A",
      "allowed-use": ["键盘焦点环", "当前选中指示", "滚动进度", "规格数值的单位", "链接悬停下划线", "章节遥测细线"],
      "forbidden-use": ["渐变（冷暖线除外）", "发光", "大面积底色", "按钮底色", "图册页面"]
    }
  },
  "type": {
    "families": {
      "ui": "Geist, Noto Sans SC, sans-serif",
      "figure": "Geist Mono, monospace",
      "figure-large": "Geist Pixel (Circle), Geist Mono, monospace",
      "brand-wordmark": "Quantify RM（仅品牌字标）"
    },
    "scale": {
      "display": { "size": "clamp(64px, 11.7vw, 168px)", "family": "Quantify RM", "line-height": 0.95 },
      "h1": { "size": "clamp(40px, 4.4vw, 64px)", "weight": 500, "tracking": "-0.04em", "line-height": 1.05 },
      "chapter": { "size": "clamp(36px, 3.89vw, 56px)", "weight": 500, "tracking": "-0.04em", "line-height": 1.1, "note": "首页章节标题（画板 05），令牌 --chapter-title；整机协同桌面例外 clamp(32px, 2.8vw, 43px)" },
      "h2": { "size": "clamp(32px, 3.3vw, 48px)", "weight": 500, "tracking": "-0.035em", "line-height": 1.1 },
      "h3": { "size": "24–28px", "weight": 500, "line-height": 1.25 },
      "lead": { "size": "18–20px", "weight": 400, "line-height": 1.7, "color": "text-2" },
      "body": { "size": "16px", "weight": 400, "line-height": "1.8（中）/ 1.7（拉丁）" },
      "caption": { "size": "13px", "line-height": 1.6, "color": "text-3" },
      "label": { "size": "11px", "weight": 500, "tracking": "+0.16em" },
      "figure": { "size": "32–56px", "family": "Geist Mono / Geist Pixel", "unit": "12–16px，sapphire-300" }
    },
    "rule": "Geist Pixel 只用于数字与单位；小于 28px 改用 Geist Mono。不用于标题与正文。"
  },
  "space": [4, 8, 12, 16, 24, 32, 48, 64, 96, 128, 192],
  "radius": { "control": 4, "panel-small": 8, "card-large": 16, "pill": 999 },
  "motion": {
    "duration-ms": { "press": 120, "hover": 240, "panel": 480, "enter": 800, "count": 1200 },
    "easing": { "settle": "cubic-bezier(.32,.72,0,1)", "reveal": "cubic-bezier(.16,1,.3,1)", "exit": "cubic-bezier(.4,0,1,1)" },
    "stagger-ms": 70,
    "max-sequence-ms": 1200,
    "reduced-motion": "关闭位移与计数，仅保留 120ms 透明度变化；内容始终完整可见"
  },
  "component": {
    "button": { "height": 48, "shape": "pill", "primary": "银白底 #F2F4F6、深色字", "hover": "提亮到 #FFFFFF，位移 -1px，240ms", "press": "scale .98，120ms" },
    "focus-ring": "2px 蓝宝石 + 2px 黑隔离，对比度 ≥ 3:1；图册保持银白焦点环",
    "card": "16px 圆角，n-2 底，1px 内描边，顶边 1px 高光线（两端渐隐），无阴影、无发光",
    "icon": "SVG，24×24 坐标系，1.6 线宽，圆角端点"
  },
  "grain": { "scope": ["首页", "模型页"], "opacity": "3–4%", "kind": "单张平铺静态图，无混合模式", "never": ["图册", "下载", "指南"] }
}
